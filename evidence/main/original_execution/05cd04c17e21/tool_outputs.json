          "text": ""
        },
        {
          "line": 24,
          "text": ""
        },
        {
          "line": 25,
          "text": "def pd_decode(s, **kwargs):"
        },
        {
          "line": 26,
          "text": "    return decode(s, **kwargs)"
        },
        {
          "line": 27,
          "text": ""
        },
        {
          "line": 28,
          "text": ""
        },
        {
          "line": 29,
          "text": "def rle_encode(types_list):"
        },
        {
          "line": 30,
          "text": "    \"\"\""
        },
        {
          "line": 31,
          "text": "    Encodes a list of type codes using Run-Length Encoding (RLE). This allows for object columns in dataframes to contain items of different types without massively bloating the encoded representation."
        },
        {
          "line": 32,
          "text": "    \"\"\""
        },
        {
          "line": 33,
          "text": "    if not types_list:"
        },
        {
          "line": 34,
          "text": "        return []"
        },
        {
          "line": 35,
          "text": ""
        },
        {
          "line": 36,
          "text": "    encoded = []"
        },
        {
          "line": 37,
          "text": "    current_type = types_list[0]"
        },
        {
          "line": 38,
          "text": "    count = 1"
        },
        {
          "line": 39,
          "text": ""
        },
        {
          "line": 40,
          "text": "    for typ in types_list[1:]:"
        },
        {
          "line": 41,
          "text": "        if typ == current_type:"
        },
        {
          "line": 42,
          "text": "            count += 1"
        },
        {
          "line": 43,
          "text": "        else:"
        },
        {
          "line": 44,
          "text": "            encoded.append([current_type, count])"
        },
        {
          "line": 45,
          "text": "            current_type = typ"
        },
        {
          "line": 46,
          "text": "            count = 1"
        },
        {
          "line": 47,
          "text": "    encoded.append([current_type, count])"
        },
        {
          "line": 48,
          "text": ""
        },
        {
          "line": 49,
          "text": "    return encoded"
        },
        {
          "line": 50,
          "text": ""
        },
        {
          "line": 51,
          "text": ""
        },
        {
          "line": 52,
          "text": "def rle_decode(encoded_list):"
        },
        {
          "line": 53,
          "text": "    \"\"\""
        },
        {
          "line": 54,
          "text": "    Decodes a Run-Length Encoded (RLE) list back into the original list of type codes."
        },
        {
          "line": 55,
          "text": "    \"\"\""
        },
        {
          "line": 56,
          "text": "    decoded = []"
        },
        {
          "line": 57,
          "text": "    for typ, count in encoded_list:"
        },
        {
          "line": 58,
          "text": "        decoded.extend([typ] * count)"
        },
        {
          "line": 59,
          "text": "    return decoded"
        },
        {
          "line": 60,
          "text": ""
        },
