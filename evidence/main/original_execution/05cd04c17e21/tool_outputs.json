          "line": 61,
          "text": ""
        },
        {
          "line": 62,
          "text": "class PandasProcessor:"
        },
        {
          "line": 63,
          "text": "    def __init__(self, size_threshold=500, compression=zlib):"
        },
        {
          "line": 64,
          "text": "        \"\"\""
        },
        {
          "line": 65,
          "text": "        :param size_threshold: nonnegative int or None"
        },
        {
          "line": 66,
          "text": "            valid values for 'size_threshold' are all nonnegative"
        },
        {
          "line": 67,
          "text": "            integers and None.  If size_threshold is None,"
        },
        {
          "line": 68,
          "text": "            dataframes are always stored as csv strings"
        },
        {
          "line": 69,
          "text": "        :param compression: a compression module or None"
        },
        {
          "line": 70,
          "text": "            valid values for 'compression' are {zlib, bz2, None}"
        },
        {
          "line": 71,
          "text": "            if compression is None, no compression is applied"
        },
        {
          "line": 72,
          "text": "        \"\"\""
        },
        {
          "line": 73,
          "text": "        self.size_threshold = size_threshold"
        },
        {
          "line": 74,
          "text": "        self.compression = compression"
        },
        {
          "line": 75,
          "text": ""
        },
        {
          "line": 76,
          "text": "    def flatten_pandas(self, buf, data, meta=None):"
        },
        {
          "line": 77,
          "text": "        if self.size_threshold is not None and len(buf) > self.size_threshold:"
        },
        {
          "line": 78,
          "text": "            if self.compression:"
        },
        {
          "line": 79,
          "text": "                buf = self.compression.compress(buf.encode())"
        },
        {
          "line": 80,
          "text": "                data['comp'] = True"
        },
        {
          "line": 81,
          "text": "            data['values'] = b64encode(buf)"
        },
        {
          "line": 82,
          "text": "            data['txt'] = False"
        },
        {
          "line": 83,
          "text": "        else:"
        },
        {
          "line": 84,
          "text": "            data['values'] = buf"
        },
        {
          "line": 85,
          "text": "            data['txt'] = True"
        },
        {
          "line": 86,
          "text": ""
        },
        {
          "line": 87,
          "text": "        data['meta'] = meta"
        },
        {
          "line": 88,
          "text": "        return data"
        },
        {
          "line": 89,
          "text": ""
        },
        {
          "line": 90,
          "text": "    def restore_pandas(self, data):"
        },
        {
          "line": 91,
          "text": "        if data.get('txt', True):"
        },
        {
          "line": 92,
          "text": "            # It's just text..."
        },
        {
          "line": 93,
          "text": "            buf = data['values']"
        },
        {
          "line": 94,
          "text": "        else:"
        },
        {
          "line": 95,
          "text": "            buf = b64decode(data['values'])"
        },
        {
          "line": 96,
          "text": "            if data.get('comp', False):"
        },
        {
          "line": 97,
          "text": "                buf = self.compression.decompress(buf).decode()"
        },
        {
          "line": 98,
          "text": "        meta = data.get('meta', {})"
        },
        {
          "line": 99,
          "text": "        return (buf, meta)"
        },
