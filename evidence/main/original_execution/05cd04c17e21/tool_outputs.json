          "text": ""
        },
        {
          "line": 18,
          "text": "def pd_encode(obj, **kwargs):"
        },
        {
          "line": 19,
          "text": "    if isinstance(obj, np.generic):"
        },
        {
          "line": 20,
          "text": "        # convert pandas/numpy scalar to native Python type"
        },
        {
          "line": 21,
          "text": "        return obj.item()"
        },
        {
          "line": 22,
          "text": "    return encode(obj, **kwargs)"
        },
        {
